[
  {
    "id": "sn-jianbing-guozi",
    "name": "煎饼果子",
    "cuisine": "小吃",
    "region": "天津",
    "type": "小吃",
    "flavor": "咸鲜",
    "time": 25,
    "difficulty": "适中",
    "servings": 2,
    "description": "以绿豆面薄饼裹鸡蛋和酥脆油条的津味早餐，平底锅也能做。",
    "ingredients": [
      {
        "name": "绿豆面",
        "amount": "60克"
      },
      {
        "name": "面粉",
        "amount": "40克"
      },
      {
        "name": "清水",
        "amount": "200毫升"
      },
      {
        "name": "鸡蛋",
        "amount": "2个"
      },
      {
        "name": "熟油条",
        "amount": "2根，购买熟制品"
      },
      {
        "name": "小葱",
        "amount": "10克"
      },
      {
        "name": "甜面酱",
        "amount": "20克"
      },
      {
        "name": "植物油",
        "amount": "5毫升"
      }
    ],
    "steps": [
      "绿豆面、面粉和清水搅成可流动的面糊，静置10分钟；小葱洗净切碎。",
      "熟油条用干锅小火复热至酥脆；不粘锅薄刷油，倒一半面糊，转锅摊薄。",
      "小火煎至面糊定形，打上一个鸡蛋并摊匀，撒一半葱花。",
      "待蛋液基本凝固后翻面，再煎约1分钟，确认鸡蛋全熟、饼皮没有湿面糊。",
      "翻回刷一半甜面酱，放一根油条折叠包紧；照此做第二份，趁热食用。"
    ],
    "tip": "面糊能顺畅流动才容易摊薄；第一次可把饼摊小一些。",
    "vegetarian": true,
    "spicy": false,
    "category": "主食"
  },
  {
    "id": "sn-shouzhua-bing",
    "name": "鸡蛋手抓饼",
    "cuisine": "小吃",
    "region": "台湾风味",
    "type": "小吃",
    "flavor": "鲜香",
    "time": 15,
    "difficulty": "简单",
    "servings": 2,
    "description": "用现成手抓饼皮夹全熟鸡蛋和生菜，十几分钟就能端上桌。",
    "ingredients": [
      {
        "name": "原味冷冻手抓饼皮",
        "amount": "2张，选植物油配方"
      },
      {
        "name": "鸡蛋",
        "amount": "2个"
      },
      {
        "name": "生菜",
        "amount": "4片"
      },
      {
        "name": "番茄酱",
        "amount": "20克"
      },
      {
        "name": "植物油",
        "amount": "5毫升"
      },
      {
        "name": "盐",
        "amount": "1克"
      }
    ],
    "steps": [
      "生菜逐片洗净并沥干；饼皮去掉隔纸，不用提前解冻。",
      "不粘锅中小火放入一张饼皮，两面各煎约2分钟，至表面金黄且内层熟透，夹出。",
      "锅中薄刷油，打一个鸡蛋，撒一半盐；翻面煎至蛋白和蛋黄全部凝固。",
      "把饼盖在鸡蛋上压合，翻回后放两片生菜、挤一半番茄酱，卷好；重复做第二份。"
    ],
    "tip": "饼皮本身含油，煎饼时通常不用额外加油。",
    "vegetarian": true,
    "spicy": false,
    "category": "主食"
  },
  {
    "id": "sn-congyou-bing",
    "name": "葱油饼",
    "cuisine": "小吃",
    "region": "上海",
    "type": "小吃",
    "flavor": "咸鲜",
    "time": 55,
    "difficulty": "适中",
    "servings": 2,
    "description": "半烫面卷入葱花和薄油酥，煎出层次分明的家常葱油饼。",
    "ingredients": [
      {
        "name": "面粉",
        "amount": "220克，其中20克做油酥"
      },
      {
        "name": "开水",
        "amount": "70毫升"
      },
      {
        "name": "常温水",
        "amount": "55毫升"
      },
      {
        "name": "小葱",
        "amount": "35克"
      },
      {
        "name": "植物油",
        "amount": "30毫升"
      },
      {
        "name": "盐",
        "amount": "3克"
      }
    ],
    "steps": [
      "200克面粉先拌入开水，再分次加常温水；放至不烫手后揉匀，盖好醒20分钟。",
      "小葱洗净沥干切碎；20克面粉、20毫升油和盐拌成稀油酥。",
      "面团分两份，分别擀成长方薄片，抹油酥、撒葱花，从长边卷紧再盘成圆形。",
      "盖好再松弛10分钟，轻轻擀成约5毫米厚的圆饼。",
      "锅中加剩下10毫升油，中小火将饼两面各煎3至4分钟，至金黄、中心无生面后切块。"
    ],
    "tip": "盘好的面团充分松弛后再擀，不容易露出葱花和油酥。",
    "vegetarian": true,
    "spicy": false,
    "category": "主食"
  },
  {
    "id": "sn-hongtang-ciba",
    "name": "红糖糍粑·糯米粉版",
    "cuisine": "小吃",
    "region": "川渝",
    "type": "小吃",
    "flavor": "香甜",
    "time": 40,
    "difficulty": "适中",
    "servings": 2,
    "description": "用糯米粉蒸团再煎的家常简化版，配红糖汁和熟黄豆粉。",
    "ingredients": [
      {
        "name": "糯米粉",
        "amount": "150克"
      },
      {
        "name": "温水",
        "amount": "120毫升"
      },
      {
        "name": "红糖",
        "amount": "35克"
      },
      {
        "name": "清水",
        "amount": "50毫升，熬糖用"
      },
      {
        "name": "熟黄豆粉",
        "amount": "15克，购买可直接食用的熟粉"
      },
      {
        "name": "植物油",
        "amount": "15毫升"
      }
    ],
    "steps": [
      "糯米粉分次加入温水，揉成柔软不流动的面团；浅盘刷少量油，把面团压成约1厘米厚。",
      "蒸锅水开后放入盘子，大火蒸15至18分钟，至整块熟透、切开没有白色生粉心。",
      "略放凉至可操作，案板抹少量油，把糯米团切成手指粗的长条。",
      "锅中放剩余油，中小火煎糍粑，每面煎至浅金黄后盛出。",
      "另用小锅将红糖和50毫升水煮至稍稠，淋在糍粑上，撒熟黄豆粉。"
    ],
    "tip": "这款用糯米粉替代浸泡、蒸熟后舂打糯米，口感会与传统舂制糍粑不同。",
    "vegetarian": true,
    "spicy": false,
    "category": "甜品"
  },
