[
  {
    "id": "es-steamed-perch",
    "name": "清蒸鲈鱼",
    "cuisine": "粤菜",
    "type": "荤菜",
    "flavor": "清淡",
    "time": 25,
    "difficulty": "简单",
    "servings": 2,
    "description": "葱姜清香衬出鱼肉的鲜甜，蒸一盘就有家的味道。",
    "ingredients": [
      {
        "name": "鲈鱼（处理干净）",
        "amount": "1条，约500克"
      },
      {
        "name": "姜",
        "amount": "15克"
      },
      {
        "name": "小葱",
        "amount": "2根"
      },
      {
        "name": "蒸鱼豉油",
        "amount": "20毫升"
      },
      {
        "name": "食用油",
        "amount": "15毫升"
      }
    ],
    "steps": [
      "鲈鱼擦干，两面厚肉处划两刀；姜切片与丝，小葱切段与丝。",
      "盘底垫姜片、葱段，放鱼，鱼肚塞少量姜丝；蒸锅加水烧至上汽。",
      "放入鱼盘，盖盖大火蒸12—15分钟，直到最厚处鱼肉完全不透明、可轻松分离，未熟继续蒸。",
      "取出倒去蒸汁，去掉旧葱姜，铺新葱姜丝并淋豉油。",
      "另锅将油烧热，关火后小心浇在葱姜丝上，即可上桌。"
    ],
    "tip": "鱼更大时延长蒸制时间，以厚肉处熟透为准。",
    "vegetarian": false,
    "spicy": false,
    "category": "热菜"
  },
